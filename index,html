<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Ad Website</title>
    <!-- Start.io SDK -->
    <script async src="https://start.io"></script>
</head>
<body style="font-family: Arial, sans-serif; text-align: center; padding: 50px;">

    <h1>Welcome to My Ad-Enabled Site</h1>
    <p>The ads should appear below this message.</p>

    <!-- Banner Ad Container -->
    <div id="startio-banner-ad" style="display:flex; justify-content:center; margin: 20px 0; min-height: 50px;"></div>

    <script>
      window.startio = window.startio || [];
      function startioTag() { startio.push(arguments); }

      // আপনার নতুন App ID সেট করা হয়েছে
      startioTag('init', '203814909'); 

      // ব্যানার বিজ্ঞাপনের জন্য
      startioTag('ad', 'banner', {
        container: 'startio-banner-ad',
        size: '320x50'
      });

      // ইন্টারস্টিশিয়াল (পুরো স্ক্রিন) বিজ্ঞাপনের জন্য
      startioTag('ad', 'interstitial');
    </script>

</body>
</html>




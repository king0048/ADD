<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Ad Site</title>
    <!-- Start.io SDK -->
    <script async src="https://start.io"></script>
</head>
<body>
    <h1>Welcome to My Website</h1>
    <p>Please wait, ads are loading...</p>

    <!-- Banner Ad Container -->
    <div id="start-io-banner" style="display:flex; justify-content:center; margin: 20px 0;"></div>

    <script>
      window.startio = window.startio || [];
      function startioTag() { startio.push(arguments); }

      // Your App ID
      startioTag('init', '203111880'); 

      // Banner Ad
      startioTag('ad', 'banner', {
        container: 'start-io-banner',
        size: '320x50'
      });

      // Interstitial Ad
      startioTag('ad', 'interstitial');
    </script>
</body>
</html>


